# Copy sang .env khi port mặc định bị chiếm. docker-compose.yml đọc các biến này.
#
# Máy dev có thể đã có Postgres khác ở 5432 (ví dụ project khác đang chạy) và app khác ở
# 8080 — khi đó container thoát hoặc app báo "Port 8080 was already in use".

# Port Postgres phía host (trong container luôn là 5432)
DB_PORT=5433

# Port app phía host
PORT=8081

# Thông tin DB — mặc định trong compose là checkino/checkino/checkino
# DB_NAME=checkino
# DB_USER=checkino
# DB_PASSWORD=checkino
